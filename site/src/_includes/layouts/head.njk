<head>
  <meta charset="utf-8">
  <title>{{ title + " | " + site.title if title else site.title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description }}">
  <meta name="generator" content="{{ eleventy.generator }}">

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

  {{ extra_head | safe }}

  {% include "layouts/favicons.njk" -%}
  {% include "layouts/social.njk" -%}

  {% css "markdown" %}{{ styles.markdown | safe }}{% endcss %}
  {% css "main" %}{{ styles.main | safe }}{% endcss %}

  <link rel="preload" href="{% getBundleFileUrl "css", "main" %}" as="style">
  <link rel="preload" href="{% getBundleFileUrl "css", "markdown" %}" as="style">
  <link rel="stylesheet" href="{% getBundleFileUrl "css", "markdown" %}">
  <link rel="stylesheet" href="{% getBundleFileUrl "css", "main" %}">
  {# TODO: opt for theme and tweak the background color by avoiding github markdown #}
</head>
